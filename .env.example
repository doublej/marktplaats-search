# MarktplaatsSearch API Configuration Example
# Copy this file to .env and update with your values
# WARNING: Never commit .env to version control

# Security Settings
TOKEN_SALT=change-this-to-random-value-in-production
TOKEN_EXPIRY_DAYS=30  # Set to enable token expiry (days)

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/marktplaats_api.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false  # Set to false in production

# CORS Settings (comma-separated origins)
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Development Settings
DEV_MODE=false  # MUST be false in production
CREATE_DEFAULT_USER=false  # NEVER enable in production
# DEFAULT_USER_TOKEN=  # Only used if CREATE_DEFAULT_USER=true
# DEFAULT_USER_NAME=  # Only used if CREATE_DEFAULT_USER=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100  # Max requests per period
RATE_LIMIT_PERIOD=60  # Period in seconds

# API Pagination Defaults
DEFAULT_FRONTEND_LIMIT=25  # Default number of listings per page for search results

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
